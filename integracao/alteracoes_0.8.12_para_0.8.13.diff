+"""Propriedades de configuração e estado persistente do Chest Part Splitter."""
+
+import bpy
+from mathutils import Vector
+from bpy.props import (
+    PointerProperty,
+    StringProperty,
+    FloatProperty,
+    IntProperty,
+    BoolProperty,
+    FloatVectorProperty,
+    EnumProperty,
+    CollectionProperty,
+)
+
+
+from .constants import (
+    CLEARANCE_PRESETS,
+    SPLIT_MODES,
+    SOLID_SOURCE_TYPES,
+    SOLID_PRIMITIVE_TYPES,
+)
+
+
+def _on_preview_transform_update(self, context):
+    """Callback disparado quando o modo de visualização ou a distância de explosão é alterada."""
+    if context and hasattr(context, "scene"):
+        try:
+            from .operators import update_preview_positions
+            update_preview_positions(context.scene)
+        except Exception:
+            pass
+
+
+def _on_param_change_mark_stale(self, context):
+    """Callback para marcar o preview como desatualizado quando parâmetros de corte ou encaixe mudam."""
+    settings = None
+    if hasattr(self, "session_status"):
+        settings = self
+    elif context and hasattr(context, "scene") and hasattr(context.scene, "chest_splitter"):
+        settings = context.scene.chest_splitter
+    elif hasattr(bpy, "context") and bpy.context and hasattr(bpy.context, "scene") and hasattr(bpy.context.scene, "chest_splitter"):
+        settings = bpy.context.scene.chest_splitter
+
+    if settings and context and context.scene:
+        from .connector_surface import get_cached_prepared_split, clear_prepared_split_cache
+        from .input_state import editor_configuration
+        prep = get_cached_prepared_split()
+        if prep is not None and prep.configuration != editor_configuration(settings, context.scene):
+            clear_prepared_split_cache()
+    if settings and getattr(settings, "session_status", "") == 'PREVIEW_VALID':
+        settings.session_status = 'PREVIEW_STALE'
+        settings.last_status = "Os ajustes mudaram. Atualize a prévia antes de criar as peças."
+        settings.last_status_level = 'WARNING'
+
+
+def _on_clearance_preset_update(self, context):
+    """Atualiza a folga por lado quando o usuário seleciona um preset."""
+    if self.clearance_preset in CLEARANCE_PRESETS:
+        self.clearance_per_side_mm = CLEARANCE_PRESETS[self.clearance_preset]
+    _on_param_change_mark_stale(self, context)
+
+
+def _poll_mesh_cutter(self, obj):
+    """Filtra objetos válidos para atuarem como cortador sólido."""
+    return obj.type == 'MESH' and obj != self.target_object
+
+
+_updating_solid_dims = False
+
+
+def _on_solid_dim_update(self, context):
+    """Atualiza as dimensões físicas locais do cortador em mm sem deriva ou recursão (SOL-03)."""
+    global _updating_solid_dims
+    if _updating_solid_dims:
+        return
+    cutter = self.solid_cutter_object
+    if not cutter or cutter.type != 'MESH' or not cutter.data:
+        return
+    try:
+        from .diagnostic import get_scene_scale_to_mm
+        import bmesh
+        unit_scale = get_scene_scale_to_mm(context.scene if context else None)
+        bm = bmesh.new()
+        bm.from_mesh(cutter.data)
+        xs = [v.co.x for v in bm.verts]
+        ys = [v.co.y for v in bm.verts]
+        zs = [v.co.z for v in bm.verts]
+        bm.free()
+
+        span_x = (max(xs) - min(xs)) if xs else 1.0
+        span_y = (max(ys) - min(ys)) if ys else 1.0
+        span_z = (max(zs) - min(zs)) if zs else 1.0
+
+        desired_x_bu = max(1e-4, self.solid_cutter_width_mm / unit_scale)
+        desired_y_bu = max(1e-4, self.solid_cutter_height_mm / unit_scale)
+        desired_z_bu = max(1e-4, self.solid_cutter_depth_mm / unit_scale)
+
+        anchor_local_tuple = cutter.get("chest_align_anchor_local")
+        anchor_world = None
+        R_pure = cutter.matrix_world.to_quaternion().to_matrix()
+        if anchor_local_tuple:
+            a_local = Vector(anchor_local_tuple)
+            anchor_world = cutter.matrix_world @ a_local
+
+        _updating_solid_dims = True
+        cutter.scale.x = desired_x_bu / max(1e-6, span_x)
+        cutter.scale.y = desired_y_bu / max(1e-6, span_y)
+        cutter.scale.z = desired_z_bu / max(1e-6, span_z)
+
+        if anchor_world is not None and anchor_local_tuple is not None:
+            a_local = Vector(anchor_local_tuple)
+            new_scaled_a = Vector((cutter.scale.x * a_local.x, cutter.scale.y * a_local.y, cutter.scale.z * a_local.z))
+            cutter.location = anchor_world - R_pure @ new_scaled_a
+    except Exception:
+        pass
+    finally:
+        _updating_solid_dims = False
+    _on_param_change_mark_stale(self, context)
+
+
+def _on_cutter_object_update(self, context):
+    """Atualiza diagnósticos imediatos ao alterar o objeto cortador."""
+    if self.solid_cutter_object and self.solid_cutter_object.type == 'MESH':
+        try:
+            from .diagnostic import get_scene_scale_to_mm
+            import bmesh
+            scale_to_mm = get_scene_scale_to_mm(context.scene if context else None)
+            cutter = self.solid_cutter_object
+            bm = bmesh.new()
+            bm.from_mesh(cutter.data)
+            bm.transform(cutter.matrix_world)
+            self.solid_cutter_is_manifold = all(e.is_manifold for e in bm.edges)
+            self.solid_cutter_non_manifold_edges = len([e for e in bm.edges if not e.is_manifold])
+            self.solid_cutter_triangles = sum(len(f.verts) - 2 for f in bm.faces)
+            vol_bu = bm.calc_volume()
+            self.solid_cutter_volume_mm3 = abs(vol_bu) * (scale_to_mm ** 3)
+            xs = [v.co.x for v in bm.verts]
+            ys = [v.co.y for v in bm.verts]
+            zs = [v.co.z for v in bm.verts]
+            if xs:
+                self.solid_cutter_dims_mm = (
+                    (max(xs) - min(xs)) * scale_to_mm,
+                    (max(ys) - min(ys)) * scale_to_mm,
+                    (max(zs) - min(zs)) * scale_to_mm,
+                )
+            bm.free()
+
+            # Sincroniza dimensões locais em mm sem recursão (SOL-03)
+            global _updating_solid_dims
+            if not _updating_solid_dims and cutter.data:
+                bm2 = bmesh.new()
+                bm2.from_mesh(cutter.data)
+                lxs = [v.co.x for v in bm2.verts]
+                lys = [v.co.y for v in bm2.verts]
+                lzs = [v.co.z for v in bm2.verts]
+                bm2.free()
+                l_span_x = (max(lxs) - min(lxs)) if lxs else 1.0
+                l_span_y = (max(lys) - min(lys)) if lys else 1.0
+                l_span_z = (max(lzs) - min(lzs)) if lzs else 1.0
+                _updating_solid_dims = True
+                try:
+                    self.solid_cutter_width_mm = l_span_x * cutter.scale.x * scale_to_mm
+                    self.solid_cutter_height_mm = l_span_y * cutter.scale.y * scale_to_mm
+                    self.solid_cutter_depth_mm = l_span_z * cutter.scale.z * scale_to_mm
+                finally:
+                    _updating_solid_dims = False
+        except Exception:
+            pass
+    _on_param_change_mark_stale(self, context)
+
+
+
+def _on_target_object_update(self, context):
+    """Callback ao alterar ou limpar o objeto alvo."""
+    # RNA callbacks also run when assigning the SAME pointer (e.g. remove_preview).
+    # Keep a persistent pointer, rather than a name/address, to survive rename/load.
+    if self.previous_target_object == self.target_object:
+        return
+    self.previous_target_object = self.target_object
+    from .geometry_loop import clear_capture
+    clear_capture(self, reason="target_change")
+    from .connector_surface import clear_prepared_split_cache
+    from .connector_editor import stop_connector_editor
+    clear_prepared_split_cache()
+    if context and context.scene:
+        stop_connector_editor(context.scene)
+    _on_param_change_mark_stale(self, context)
+
+
+def _on_status_update(self, context):
+    # A direct error/status must replace a previous localized status code too.
+    self.last_status_code = ""
+    self.last_status_params = ""
